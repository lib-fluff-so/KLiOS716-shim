From 666ca74d570b25421a8130b56ba2a13e3dab80a5 Mon Sep 17 00:00:00 2001
From: KL7 <kl7@localhost>
Date: Thu, 22 Oct 2026 21:27:07 +0300
Subject: [PATCH] kl7: early framebuffer geometry and Device-memory bootstrap
 mapping

The visible KL7 page lives at 0xFE519E00 (1080x2436, stride 4352), inside one
32MiB block. Replace sweet's hard-coded 0x9c000000/1080x2400/4320, and map the
block as Device-nGnRnE so the TEE-owned memory in the same block (tkv-reserved)
cannot be speculatively read.
---
 osfmk/arm64/arm_vm_init.c     |  6 +++---
 osfmk/arm64/start.s           | 17 +++++++++++------
 osfmk/arm64/sweet_early.c     | 12 +++++++-----
 pexpert/pexpert/arm64/SWEET.h | 14 +++++++++++++-
 4 files changed, 34 insertions(+), 15 deletions(-)

diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 06bb568..ffe31d4 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1843,9 +1843,9 @@ sweet_early_map_final(void)
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
 	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	*slot = ((uint64_t)SWEET_EARLY_FB_PHYS & ~(uint64_t)SWEET_EARLY_FB_BLOCK_MASK) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
 	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
-	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE) | /* Device: see start.s */
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
 	__asm__ volatile("dsb ishst" ::: "memory");
 }
@@ -2190,7 +2190,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 #if defined(SWEET)
 	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
-	sweet_early_relocate(SWEET_EARLY_FB_VA);
+	sweet_early_relocate(SWEET_EARLY_FB_VA + (SWEET_EARLY_FB_PHYS & SWEET_EARLY_FB_BLOCK_MASK));
 #endif
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 777aca4..6224f17 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -465,10 +465,10 @@ LEXT(start_first_cpu)
 
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	MOV64	x0, (SWEET_EARLY_FB_PHYS + (SWEET_EARLY_FB_HEIGHT - 32) * SWEET_EARLY_FB_STRIDE)
 	mov		w1, #-1
 	mov		x2, #32
-	mov		x4, #4320
+	MOV64	x4, SWEET_EARLY_FB_STRIDE
 Lsweet_mark_row:
 	mov		x3, #64
 	mov		x5, x0
@@ -630,14 +630,19 @@ Lkernelcache_base_found:
 
 #if defined(SWEET)
 	/*
-	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
+	 * Splash framebuffer: one 32MB Device block in the EXISTING V=P
 	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
 	 * create_bootstrap_mapping would replace the RAM L2 table.
-	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
+	 * SWEET/KL7 use 16K pages (one L1 entry spans 64GB), so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
-	MOV64	x10, 0x9c000000
-	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	MOV64	x10, (SWEET_EARLY_FB_PHYS & ~SWEET_EARLY_FB_BLOCK_MASK)
+	/*
+	 * KL7: Device-nGnRnE, not Normal-NC. The 32MB block around the panel
+	 * buffer also contains TEE-owned memory (tkv-reserved at 0xffff7000);
+	 * Device memory is never speculatively read, Normal memory may be.
+	 */
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 6928957..233506c 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -1,5 +1,5 @@
 /*
- * Redmi Note 10 Pro bootstrap console. No allocation, locks, ADT parsing or
+ * Bootstrap console (sweet / KL7). No allocation, locks, ADT parsing or
  * per-CPU state: panic() can reach this before a current thread exists.
  * start.s maps the splash framebuffer VA=PA as Normal Non-Cacheable memory.
  * arm_vm_init installs a reserved kernel VA alias before removing TTBR0;
@@ -11,11 +11,13 @@
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)SWEET_EARLY_FB_PHYS;
 #define EARLY_FB early_fb
-#define EARLY_WIDTH 1080u
-#define EARLY_HEIGHT 2400u
-#define EARLY_STRIDE (4320u / 4)
+#define EARLY_WIDTH ((unsigned)SWEET_EARLY_FB_WIDTH)
+#define EARLY_HEIGHT ((unsigned)SWEET_EARLY_FB_HEIGHT)
+#define EARLY_STRIDE ((unsigned)SWEET_EARLY_FB_STRIDE / 4u)
+_Static_assert((SWEET_EARLY_FB_PHYS >> 25) == ((SWEET_EARLY_FB_PHYS + SWEET_EARLY_FB_HEIGHT * SWEET_EARLY_FB_STRIDE - 1) >> 25),
+    "early framebuffer must sit inside one 32MiB block");
 #define EARLY_SCALE 2u
 #define EARLY_CELL_W (8u * EARLY_SCALE)
 #define EARLY_CELL_H (16u * EARLY_SCALE)
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index a044ad0..04479a4 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -39,9 +39,21 @@
  * virt, hyp) instead of the usual 13/14/11/10: the virtual timer XNU uses
  * (CNTV) is INTID 16 + 3 = 19.
  */
-#define SWEET_VTIMER_INTID        19
+#define SWEET_VTIMER_INTID        19      // default; the ADT gic node overrides it (KL7: 27)
 #define SWEET_IPI_SGI             1       // SGI used for cross-CPU signals
 
+/*
+ * Boot-loader framebuffer used by the bootstrap console (KL7: the page the
+ * panel scans out, 1230 rows into the 0xFDFFF000 reserved region). Plain
+ * numbers so start.s can use them. The whole visible page must lie inside ONE
+ * 32 MiB level-2 block (16K granule): bootstrap TTBR0 maps that block.
+ */
+#define SWEET_EARLY_FB_PHYS       0xFE519E00
+#define SWEET_EARLY_FB_WIDTH      1080
+#define SWEET_EARLY_FB_HEIGHT     2436
+#define SWEET_EARLY_FB_STRIDE     4352
+#define SWEET_EARLY_FB_BLOCK_MASK 0x1FFFFFF
+
 #define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
 
 #define GICR_PE_SIZE              0x20000 // Size of each redistributor region
