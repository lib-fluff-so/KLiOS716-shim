From 1f12cb7bb9e56ecbb9367bff5c5c93d5363d449e Mon Sep 17 00:00:00 2001
From: KL7 <kl7@localhost>
Date: Fri, 23 Oct 2026 21:43:40 +0300
Subject: [PATCH] kl7: mirror the framebuffer console into the ramoops console
 zone

Every byte sent to the fbcon serial function (kprintf and console output) is
also written to the persistent_ram_buffer at the ADT node kl7-ramoops, so the
XNU log is readable from Android pstore after a warm reset, appended to the
shim's own log.
---
 pexpert/arm/pe_serial.c | 86 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 86 insertions(+)

diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index 681da16..b67bbdc 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -721,6 +721,90 @@ static volatile uint32_t *fbcon_base;
 static uint32_t fbcon_width, fbcon_height, fbcon_stride;
 static uint32_t fbcon_cols, fbcon_rows, fbcon_col, fbcon_row;
 
+/*
+ * KL7: mirror every byte that reaches the framebuffer console into the
+ * Linux ramoops console zone, so the log can be read from Android
+ * (/sys/fs/pstore/console-ramoops-0) after a warm reset. Same ring format as
+ * the boot shim (persistent_ram_buffer: sig, start, size, data[]), and the
+ * ring the shim already filled is continued, not erased. The ADT node
+ * "kl7-ramoops" carries reg = <phys size> (absolute). No locks, no allocation:
+ * this runs from panic paths. Mapped as Device memory so every store is
+ * ordered and reaches DRAM.
+ */
+#define KL7_RAMOOPS_SIG 0x43474244u
+
+struct kl7_prb {
+	volatile uint32_t sig;
+	volatile uint32_t start;
+	volatile uint32_t size;
+	volatile uint8_t  data[];
+};
+
+static volatile struct kl7_prb *kl7_rb;
+static uint32_t kl7_rb_cap, kl7_rb_pos, kl7_rb_used;
+
+static void
+kl7_ramoops_putc(uint8_t c)
+{
+	volatile struct kl7_prb *b = kl7_rb;
+	if (b == NULL) {
+		return;
+	}
+	uint32_t pos = kl7_rb_pos;
+	b->data[pos++] = c;
+	if (pos == kl7_rb_cap) {
+		pos = 0;
+	}
+	if (kl7_rb_used < kl7_rb_cap) {
+		kl7_rb_used++;
+	}
+	kl7_rb_pos = pos;
+	b->size = kl7_rb_used;
+	b->start = pos;
+	if (c == '\n') {
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+}
+
+static void
+kl7_ramoops_probe(void)
+{
+	DTEntry entry;
+	uint64_t const *reg;
+	unsigned int size;
+
+	if (SecureDTFindEntry("name", "kl7-ramoops", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess || size < 16) {
+		return;
+	}
+	uint64_t len = reg[1];
+	if (len <= sizeof(struct kl7_prb) + 16 || len > 0x1000000) {
+		return;
+	}
+	volatile struct kl7_prb *b = (volatile struct kl7_prb *)ml_io_map((vm_offset_t)reg[0], (vm_size_t)len);
+	if (b == NULL) {
+		return;
+	}
+	uint32_t cap = (uint32_t)len - (uint32_t)sizeof(struct kl7_prb);
+	if (b->sig == KL7_RAMOOPS_SIG && b->start < cap && b->size <= cap) {
+		kl7_rb_pos = b->start;
+		kl7_rb_used = b->size;
+	} else {
+		b->sig = 0;
+		b->start = 0;
+		b->size = 0;
+		b->sig = KL7_RAMOOPS_SIG;
+		kl7_rb_pos = 0;
+		kl7_rb_used = 0;
+	}
+	kl7_rb_cap = cap;
+	kl7_rb = b;
+	static const char sep[] = "\n--- xnu console ---\n";
+	for (unsigned int i = 0; i < sizeof(sep) - 1; i++) {
+		kl7_ramoops_putc((uint8_t)sep[i]);
+	}
+}
+
 static void
 fbcon_clear_row(uint32_t row)
 {
@@ -761,6 +845,7 @@ fbcon_transmit_ready(void)
 static void
 fbcon_transmit_data(uint8_t c)
 {
+	kl7_ramoops_putc(c);
 	if (c == '\r') {
 		fbcon_col = 0;
 		return;
@@ -839,6 +924,7 @@ fbcon_probe(void)
 	fbcon_base = (volatile uint32_t *)ml_io_map_wcomb(reg[0], reg[1]);
 	sweet_early_mark(18, "fbcon mapping returned");
 	if (fbcon_base != NULL) {
+		kl7_ramoops_probe();
 		register_serial_functions(&sweet_fbcon_serial_functions);
 	}
 }
