From f99273f69efa119534a52d9137011387e4081c5a Mon Sep 17 00:00:00 2001
From: KL7 <kl7@localhost>
Date: Thu, 22 Oct 2026 21:27:56 +0300
Subject: [PATCH] kl7: match KL7 platform, CPU and framebuffer nodes in the ADT

Accept tecno,kl7 (platform), arm,cortex-a55/a76 (CPU) and kl7-fbcon next to the
sweet names. Identity strings already come from the ADT (sweet 0059); display,
touch and UFS drivers are deliberately untouched (later milestones).
---
 iokit/Kernel/arm/SweetCPU.cpp | 2 +-
 iokit/KernelConfigTables.cpp  | 4 ++--
 pexpert/arm/pe_serial.c       | 3 ++-
 3 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index 2545cf9..5115cc0 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -82,7 +82,7 @@ SweetCPU::start(IOService *provider)
 	if (!IOCPU::start(provider)) {
 		return false;
 	}
-	cpuName = OSSymbol::withCStringNoCopy("Kryo 470");
+	cpuName = OSSymbol::withCStringNoCopy("Cortex-A55/A76");
 	if (cpuName == NULL) {
 		return false;
 	}
diff --git a/iokit/KernelConfigTables.cpp b/iokit/KernelConfigTables.cpp
index 92f3e26..7d05e91 100644
--- a/iokit/KernelConfigTables.cpp
+++ b/iokit/KernelConfigTables.cpp
@@ -38,13 +38,13 @@ const char * gIOKernelConfigTables =
     "   {"
     "     'IOClass'         = SweetPlatformExpert;"
     "     'IOProviderClass' = IOPlatformExpertDevice;"
-    "     'IONameMatch'     = 'xiaomi,sweet';"
+    "     'IONameMatch'     = ('xiaomi,sweet', 'tecno,kl7');"
     "     'IOProbeScore'    = 10000:32;"
     "   },"
     "   {"
     "     'IOClass'         = SweetCPU;"
     "     'IOProviderClass' = IOPlatformDevice;"
-    "     'IONameMatch'     = 'qcom,kryo470';"
+    "     'IONameMatch'     = ('qcom,kryo470', 'arm,cortex-a55', 'arm,cortex-a76');"
     "     'IOProbeScore'    = 10000:32;"
     "   },"
     "   {"
diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index 19f27cd..681da16 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -818,7 +818,8 @@ fbcon_probe(void)
 	uint32_t const *val;
 	unsigned int size;
 
-	if (SecureDTFindEntry("name", "sweet-fbcon", &entry) != kSuccess ||
+	if ((SecureDTFindEntry("name", "sweet-fbcon", &entry) != kSuccess &&
+	    SecureDTFindEntry("name", "kl7-fbcon", &entry) != kSuccess) ||
 	    SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess || size < 16) {
 		return;
 	}
