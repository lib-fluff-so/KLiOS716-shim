+/*
+ * v0117: the KL7 bootloader leaves UniPro in PWM (PA_PWRMODE=0x55, i.e.
+ * SLOWAUTO/SLOWAUTO).  The Android kernel then performs the standard HS
+ * power-mode change; this driver historically skipped it, which is why the
+ * link moved at PWM-G1 speed (~480 KiB/s).  The shim proved HS-G3 series B
+ * with two lanes sustains about 800 MiB/s, so use that here.
+ */
+static int
+mtk_hs_get(uint32_t opcode, uint32_t attr, const char *name, uint32_t *val)
+{
+	uint32_t v = 0;
+	uint32_t r = mtk_uic(opcode, attr << 16, 0, 0, &v);
+	printf("KL7 UFS: HS %s rc 0x%x val 0x%x\n", name, r, v);
+	if (val) {
+		*val = v;
+	}
+	return r ? EIO : 0;
+}
+
+static int
+mtk_hs_set(uint32_t attr, uint32_t val, const char *name)
+{
+	uint32_t v = 0;
+	uint32_t r = mtk_uic(UIC_CMD_DME_SET, attr << 16, 0, val, &v);
+	printf("KL7 UFS: HS set %s=%u rc 0x%x\n", name, val, r);
+	return r ? EIO : 0;
+}
+
+/*
+ * A DME_SET(PA_PWRMODE) completes in two stages: UIC_COMMAND_COMPL only says
+ * the command was accepted; IS.UIC_POWER_MODE and HCS.UPMCRS report the
+ * actual link change.  Linux's ufshcd_uic_pwr_ctrl() waits for both.
+ */
+static uint32_t
+mtk_hs_pwr_change(uint32_t mode, const char *name)
+{
+	uint32_t v = 0, is, hcs, upmcrs;
+	uint32_t r;
+
+	ufs_wr(REG_IS, IS_UIC_POWER_MODE);
+	r = mtk_uic(UIC_CMD_DME_SET, PA_PWRMODE << 16, 0, mode, &v);
+	printf("KL7 UFS: HS set %s=0x%x rc 0x%x\n", name, mode, r);
+	if (r) {
+		return r;
+	}
+	for (int i = 0; i < 10000; i++) {        /* 1 s */
+		if (ufs_rd(REG_IS) & IS_UIC_POWER_MODE) {
+			break;
+		}
+		delay(100);
+	}
+	is = ufs_rd(REG_IS);
+	hcs = ufs_rd(REG_HCS);
+	upmcrs = (hcs >> 8) & 7u;
+	ufs_wr(REG_IS, IS_UIC_POWER_MODE);
+	printf("KL7 UFS: HS %s done is 0x%x hcs 0x%x upmcrs %u\n",
+	    name, is, hcs, upmcrs);
+	if (!(is & IS_UIC_POWER_MODE)) {
+		return 0x100;
+	}
+	return upmcrs == HCS_UPMCRS_PWR_LOCAL ? 0 : (0x200u | upmcrs);
+}
+
+static int
+mtk_hs_switch(void)
+{
+	uint32_t rxlanes = 0, txlanes = 0, local = 0, peer = 0;
+	uint32_t pwr = 0, v = 0, r, gear = KL7_UFS_HS_GEAR, txgear = 0;
+
+	printf("KL7 UFS: HS enter\n");
+	if (mtk_hs_get(UIC_CMD_DME_GET, PA_CONNECTEDRXDATALANES,
+	    "connected_rx", &rxlanes) ||
+	    mtk_hs_get(UIC_CMD_DME_GET, PA_CONNECTEDTXDATALANES,
+	    "connected_tx", &txlanes)) {
+		return EIO;
+	}
+	if (mtk_hs_get(UIC_CMD_DME_GET, PA_MAXRXHSGEAR, "max_hs_local", &local) ||
+	    mtk_hs_get(UIC_CMD_DME_PEER_GET, PA_MAXRXHSGEAR, "max_hs_peer",
+	    &peer)) {
+		return EIO;
+	}
+	if (!rxlanes || !txlanes || rxlanes > 2 || txlanes > 2) {
+		printf("KL7 UFS: HS bad lanes rx %u tx %u\n", rxlanes, txlanes);
+		return EIO;
+	}
+	if (!peer) {
+		printf("KL7 UFS: HS peer has no HS gear\n");
+		return EIO;
+	}
+	if (gear > local) {
+		gear = local;
+	}
+	if (gear > peer) {
+		gear = peer;
+	}
+	if (!gear) {
+		printf("KL7 UFS: HS no usable gear\n");
+		return EIO;
+	}
+	printf("KL7 UFS: HS caps lanes %u/%u, max gear local %u peer %u, target %u\n",
+	    rxlanes, txlanes, local, peer, gear);
+
+	if (mtk_hs_set(PA_RXGEAR, gear, "rxgear") ||
+	    mtk_hs_set(PA_ACTIVERXDATALANES, rxlanes, "rxlanes") ||
+	    mtk_hs_set(PA_RXTERMINATION, 1, "rxterm") ||
+	    mtk_hs_set(PA_TXGEAR, gear, "txgear") ||
+	    mtk_hs_set(PA_ACTIVETXDATALANES, txlanes, "txlanes") ||
+	    mtk_hs_set(PA_TXTERMINATION, 1, "txterm") ||
+	    mtk_hs_set(PA_HSSERIES, PA_HS_MODE_B, "hsseries_b")) {
+		return EIO;
+	}
+
+	/* Timeout user-data is advisory; the bootloader may already set it. */
+	(void)mtk_hs_set(PA_PWRMODEUSERDATA0, 8191, "ud0");
+	(void)mtk_hs_set(PA_PWRMODEUSERDATA1, 65535, "ud1");
+	(void)mtk_hs_set(PA_PWRMODEUSERDATA2, 32767, "ud2");
+	(void)mtk_hs_set(PA_PWRMODEUSERDATA3, 8191, "ud3");
+	(void)mtk_hs_set(PA_PWRMODEUSERDATA4, 65535, "ud4");
+	(void)mtk_hs_set(PA_PWRMODEUSERDATA5, 32767, "ud5");
+
+	/* FAST (0x1) for both directions: 0x11.  FASTAUTO would be 0x44. */
+	r = mtk_hs_pwr_change(0x11, "pwr_0x11");
+	if (r) {
+		printf("KL7 UFS: HS power change failed 0x%x, restoring PWM\n", r);
+		r = mtk_hs_pwr_change(0x55, "pwm_restore");
+		if (r) {
+			printf("KL7 UFS: HS PWM restore failed 0x%x\n", r);
+		}
+		return EIO;
+	}
+	if (mtk_hs_get(UIC_CMD_DME_GET, PA_PWRMODE, "pwr_readback", &pwr)) {
+		return EIO;
+	}
+	if (mtk_hs_get(UIC_CMD_DME_GET, PA_TXGEAR, "txgear_readback", &txgear)) {
+		return EIO;
+	}
+	(void)mtk_hs_get(UIC_CMD_DME_GET, PA_RXGEAR, "rxgear_readback", &v);
+	(void)mtk_hs_get(UIC_CMD_DME_GET, PA_TXPWRSTATUS, "txstatus", &v);
+	(void)mtk_hs_get(UIC_CMD_DME_GET, PA_RXPWRSTATUS, "rxstatus", &v);
+	printf("KL7 UFS: HS ACTIVE pwr 0x%x gear %u hcs 0x%x\n",
+	    pwr, txgear, ufs_rd(REG_HCS));
+	return 0;
+}
+
