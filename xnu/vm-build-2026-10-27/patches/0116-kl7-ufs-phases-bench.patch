+/*
+ * v0116: raw read benchmark, boot-arg ufsbench=N. Each size is read for at
+ * least 4 commands (N MiB in total per size) with and without the bounce
+ * buffer cache maintenance. Timing never includes console output: the last
+ * command's phases are kept in ufs_last_* and printed afterwards.
+ */
+static void
+ufs_bench_pass(uint32_t mib, bool nosync)
+{
+	static const uint32_t sizes[] = { 4096, 16384, 65536, 262144, 1048576 };
+	uint64_t base = su.first_block + (1ull << 30) / UFS_BLOCK;
+	uint64_t limit = su.first_block + su.nblocks;
+
+	ufs_nosync = nosync;
+	for (unsigned i = 0; i < sizeof(sizes) / sizeof(sizes[0]); i++) {
+		uint32_t size = sizes[i];
+		uint32_t blocks = size / UFS_BLOCK;
+		uint32_t cmds = (mib << 20) / size;
+		if (cmds < 4) {
+			cmds = 4;
+		}
+		if (base + (uint64_t)cmds * blocks > limit) {
+			break;
+		}
+		uint64_t t0 = mach_absolute_time();
+		int err = 0;
+		for (uint32_t c = 0; c < cmds; c++) {
+			err = ufs_read_blocks(base + (uint64_t)c * blocks, blocks);
+			if (err) {
+				break;
+			}
+		}
+		uint64_t ns = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		uint64_t bytes = (uint64_t)cmds * size;
+		printf("SWEET UFS BENCH: %s %u x%u %llu KiB/s %llu us/cmd"
+		    " pre %llu hw %llu post %llu polls %u err %d\n",
+		    nosync ? "nosync" : "sync", size, cmds,
+		    ns ? bytes / 1024 * 1000000000ull / ns : 0,
+		    cmds ? ns / cmds / 1000 : 0,
+		    ufs_last_pre_ns / NSEC_PER_USEC, ufs_last_hw_ns / NSEC_PER_USEC,
+		    ufs_last_post_ns / NSEC_PER_USEC, ufs_last_polls, err);
+	}
+	ufs_nosync = false;
+}
