From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: KL7 <kl7@localhost>
Date: Fri, 23 Oct 2026 23:50:00 +0300
Subject: [PATCH] kl7: enable bsd_init progress messages (DEBUG_BSDINIT)

Temporary diagnostic: print every bsd_init() step so the next blocker
after IOKitInitializeTime() is visible in the ramoops console.
---
 bsd/kern/bsd_init.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -489,9 +489,9 @@
 #if (DEVELOPMENT || DEBUG)
 	platform_stall_panic_or_spin(PLATFORM_STALL_XNU_LOCATION_BSD_INIT);
 #endif
 
-#define DEBUG_BSDINIT 0
+#define DEBUG_BSDINIT 1
 
 #if DEBUG_BSDINIT
 #define bsd_init_kprintf(x, ...) kprintf("bsd_init: " x, ## __VA_ARGS__)
 #else
