From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: KL7 <kl7@localhost>
Date: Sun, 25 Oct 2026 13:40:00 +0300
Subject: [PATCH] kl7: sampler v2 - trap number (x16), x0 and thread state

The parked SpringBoard/backboardd threads never leave dyld4::prepare:
their saved user pc is the return point of a direct dyld syscall (dyld
issues its own "svc #0x80" stubs with the call number in x16).  Print the
saved x16/x0 and the kernel thread state next to pc/lr/sp, so one boot
tells whether a thread is suspended (TH_SUSP), waiting in the kernel
(TH_WAIT) or runnable (TH_RUN), and which syscall/trap it entered
(e.g. 184 = dtracehelper DOF registration).  Sampling starts after 45 s
and repeats every 45 s for at most 40 samples, so a syscall that takes
minutes is caught several times and its duration is readable from the
sample spacing.
---
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1016,5 +1016,5 @@
 		arm_saved_state_t *ss = find_user_regs(thread);
-		char line[400];
+		char line[512];
 		int n;
 		uint64_t fp;
 
@@ -1022,6 +1022,7 @@
 			continue;
 		}
 		fp = get_saved_state_fp(ss);
-		n = snprintf(line, sizeof(line), "SMP %s t%d pc 0x%llx lr 0x%llx sp 0x%llx bt", name, tn++,
-		    get_saved_state_pc(ss), get_saved_state_lr(ss), get_saved_state_sp(ss));
+		n = snprintf(line, sizeof(line), "SMP %s t%d pc 0x%llx lr 0x%llx sp 0x%llx x16 0x%llx x0 0x%llx st 0x%x bt", name, tn++,
+		    get_saved_state_pc(ss), get_saved_state_lr(ss), get_saved_state_sp(ss),
+		    get_saved_state_reg(ss, 16), get_saved_state_reg(ss, 0), thread->state);
 		for (int i = 0; i < 16 && fp != 0 && (fp & 7) == 0 && n < (int)sizeof(line) - 20; i++) {
 			uint64_t frame[2];
 			if (vm_map_read_user(map, fp, frame, sizeof(frame)) != KERN_SUCCESS) {
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -10,5 +10,5 @@
  * with tools/sweet-crash.py). A thread blocked in a syscall shows the
  * syscall stub in pc and its caller in lr/bt.
  *
- * First sample 90 s after start, then every 120 s, 40 samples at most.
+ * First sample 45 s after start, then every 45 s, 40 samples at most.
  */
@@ -73,6 +73,6 @@
-	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
+	(void)tsleep(&chan, PZERO, "sweetsmp", 45 * hz);
 	for (int i = 0; i < 40; i++) {
 		printf("SMP --- sample %d\n", i);
 		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
-		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
+		(void)tsleep(&chan, PZERO, "sweetsmp", 45 * hz);
 	}
