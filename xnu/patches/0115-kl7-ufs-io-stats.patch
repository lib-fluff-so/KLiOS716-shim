+/*
+ * v0115: I/O accounting. The process sampler calls sweet_ufs_stats_dump()
+ * every interval; the numbers are the deltas since the previous call, so
+ * "SMP --- sample N" and "SMP UFSIO: ..." describe the same 45 s window.
+ * slow_printed is cumulative and only caps the "slow command" console lines.
+ */
+struct ufs_io_interval {
+	uint64_t cmds, bytes, ns, max_ns;
+	uint64_t rd_cmds, rd_bytes, rd_ns, rd_max_ns;
+	uint64_t wr_cmds, wr_bytes, wr_ns, wr_max_ns;
+	uint64_t sync_cmds, sync_ns, sync_max_ns;
+	uint64_t other_cmds;
+	uint64_t lock_ns, lock_max_ns;
+	uint64_t sleepable_cmds, spin_cmds;
+	uint64_t hist[5];
+	uint64_t slow, slow_printed;
+};
+static struct ufs_io_interval ufsio;
+static bool ufs_spin;                   /* boot-arg ufsspin=1: busy-poll, never sleep */
+
+#define SPIN_MAX_NS     (2ull * NSEC_PER_MSEC)
+#define SLOW_NS         (20ull * NSEC_PER_MSEC)
+
+static void
+ufs_account(uint32_t op, uint32_t len, uint64_t t0)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	ufsio.cmds++;
+	ufsio.bytes += len;
+	ufsio.ns += ns;
+	if (ns > ufsio.max_ns) {
+		ufsio.max_ns = ns;
+	}
+	switch (op) {
+	case 0x28:                                          /* READ(10) */
+		ufsio.rd_cmds++;
+		ufsio.rd_bytes += len;
+		ufsio.rd_ns += ns;
+		if (ns > ufsio.rd_max_ns) {
+			ufsio.rd_max_ns = ns;
+		}
+		break;
+	case 0x2a:                                          /* WRITE(10) */
+		ufsio.wr_cmds++;
+		ufsio.wr_bytes += len;
+		ufsio.wr_ns += ns;
+		if (ns > ufsio.wr_max_ns) {
+			ufsio.wr_max_ns = ns;
+		}
+		break;
+	case 0x35:                                          /* SYNCHRONIZE CACHE(10) */
+		ufsio.sync_cmds++;
+		ufsio.sync_ns += ns;
+		if (ns > ufsio.sync_max_ns) {
+			ufsio.sync_max_ns = ns;
+		}
+		break;
+	default:
+		ufsio.other_cmds++;
+		break;
+	}
+	uint32_t h = len >= (256u << 10) ? 4 : len >= (64u << 10) ? 3 :
+	    len >= (16u << 10) ? 2 : len >= 4096 ? 1 : 0;
+	ufsio.hist[h]++;
+	if (ns >= SLOW_NS) {
+		ufsio.slow++;
+		if (ufsio.slow_printed < 200) {
+			ufsio.slow_printed++;
+			printf("SWEET UFS: slow op 0x%02x len %u us %llu\n",
+			    op, len, ns / NSEC_PER_USEC);
+		}
+	}
+}
+
+void sweet_ufs_stats_dump(const char *tag);
+
+void
+sweet_ufs_stats_dump(const char *tag)
+{
+	struct ufs_io_interval s;
+	memcpy(&s, &ufsio, sizeof(s));
+	bzero(&ufsio, sizeof(ufsio));
+	ufsio.slow_printed = s.slow_printed;
+	printf("%s UFSIO: cmds %llu %lluK avg %lluus max %lluus"
+	    " | rd %llu %lluK avg %lluus max %lluus"
+	    " | wr %llu %lluK avg %lluus max %lluus"
+	    " | sync %llu avg %lluus max %lluus | other %llu"
+	    " | lockwait %lluus max %lluus | sleepable %llu spin %llu"
+	    " | hist <4K %llu <16K %llu <64K %llu <256K %llu >=256K %llu"
+	    " | slow %llu\n",
+	    tag, s.cmds, s.bytes >> 10,
+	    s.cmds ? s.ns / s.cmds / NSEC_PER_USEC : 0, s.max_ns / NSEC_PER_USEC,
+	    s.rd_cmds, s.rd_bytes >> 10,
+	    s.rd_cmds ? s.rd_ns / s.rd_cmds / NSEC_PER_USEC : 0,
+	    s.rd_max_ns / NSEC_PER_USEC,
+	    s.wr_cmds, s.wr_bytes >> 10,
+	    s.wr_cmds ? s.wr_ns / s.wr_cmds / NSEC_PER_USEC : 0,
+	    s.wr_max_ns / NSEC_PER_USEC,
+	    s.sync_cmds,
+	    s.sync_cmds ? s.sync_ns / s.sync_cmds / NSEC_PER_USEC : 0,
+	    s.sync_max_ns / NSEC_PER_USEC, s.other_cmds,
+	    s.lock_ns / NSEC_PER_USEC, s.lock_max_ns / NSEC_PER_USEC,
+	    s.sleepable_cmds, s.spin_cmds,
+	    s.hist[0], s.hist[1], s.hist[2], s.hist[3], s.hist[4], s.slow);
+}
+
 static LCK_GRP_DECLARE(sweet_ufs_grp, "sweet_ufs");
 static LCK_MTX_DECLARE(sweet_ufs_lock, &sweet_ufs_grp);
 
