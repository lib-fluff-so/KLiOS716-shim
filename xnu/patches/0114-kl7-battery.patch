+/*
+ * KL7 (Tecno Spark 30 Pro, MT6789 + MT6366 + SGM41516D) battery backend.
+ *
+ * The register sequences and timing here are the ones already exercised by
+ * the shim's read-only battery probe and by the guarded charger write test.
+ * The normal path is read-only: AUXADC BATADC/BAT_TEMP plus SGM41516D status
+ * registers.  Charger writes happen only from
+ * kl7_battery_enable_slow_charge(), which the IOKit service calls only when
+ * the kl7slowchg=1 boot argument is present.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/device_tree.h>
+
+#include "kl7_battery.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define KL7B_PWRAP_PA           0x10026000u
+#define KL7B_I2C5_PA            0x11017000u
+#define KL7B_TOPCKGEN_PA        0x10000000u
+#define KL7B_IFRAO_PA           0x10001000u
+#define KL7B_IMPC_PA            0x1101b000u
+#define KL7B_GPIO_PA            0x10005000u
+#define KL7B_MMIO_SIZE          0x1000u
+
+#define KL7B_PWRAP_INIT_DONE2   0x0000u
+#define KL7B_PWRAP_WACS2_CMD    0x0880u
+#define KL7B_PWRAP_WDATA        0x0884u
+#define KL7B_PWRAP_RDATA        0x0894u
+#define KL7B_PWRAP_VLDCLR       0x08a4u
+#define KL7B_PWRAP_RDATA_FSM    0x08a8u
+
+#define KL7B_PMIC_TIMEOUT_US    10000u
+#define KL7B_FSM_READY          0u
+#define KL7B_FSM_READ_DONE      6u
+
+#define KL7B_MT6358_SWCID       0x000au
+#define KL7B_MT6358_ADC0        0x1088u
+#define KL7B_MT6358_ADC2        0x108cu
+#define KL7B_MT6358_ADC3        0x108eu
+#define KL7B_MT6358_ADC4        0x1090u
+#define KL7B_MT6358_RQST0       0x1108u
+#define KL7B_MT6366_CHIP_ID     0x66u
+#define KL7B_MT6358_CHIP_ID     0x58u
+
+#define KL7B_AUXADC_RDY_SHIFT   15u
+#define KL7B_AUXADC_AVG_US      10u
+#define KL7B_AUXADC_POLLS       160u
+#define KL7B_AUXADC_POLL_US     150u
+#define KL7B_AUXADC_FULL_MV     1800u
+
+#define KL7B_TOP_CLK_CFG_10     0x00b0u
+#define KL7B_TOP_CLK_CFG_10_SET 0x00b4u
+#define KL7B_TOP_CLK_CFG_10_CLR 0x00b8u
+#define KL7B_TOP_CLK_CFG_UPDATE1 0x0008u
+#define KL7B_TOP_I2C_MUX_SHIFT  8u
+#define KL7B_TOP_I2C_MUX_MASK   0x0300u
+#define KL7B_TOP_I2C_MUX_UPDATE 10u
+#define KL7B_TOP_I2C_MUX_GATE   15u
+#define KL7B_TOP_I2C_PARENT     1u
+#define KL7B_TOP_I2C_UPDATE_BIT (1u << KL7B_TOP_I2C_MUX_UPDATE)
+#define KL7B_TOP_I2C_GATE_BIT   (1u << KL7B_TOP_I2C_MUX_GATE)
+
+#define KL7B_IFRAO_GATE_CLR     0x0084u
+#define KL7B_IFRAO_GATE_STA     0x0090u
+#define KL7B_IFRAO_I2C_BIT      (1u << 11)
+#define KL7B_IMPC_GATE_CLR      0x0e04u
+#define KL7B_IMPC_GATE_STA      0x0e00u
+#define KL7B_IMPC_I2C5_BIT      (1u << 1)
+
+#define KL7B_I2C_SCL_PIN        140u
+#define KL7B_I2C_SDA_PIN        141u
+#define KL7B_I2C_PIN_FUNC       1u
+#define KL7B_GPIO_MODE_REG(pin) (0x0300u + ((pin) / 8u) * 0x10u)
+#define KL7B_GPIO_MODE_SHIFT(pin) (((pin) % 8u) * 4u)
+#define KL7B_GPIO_MODE_MASK     0x0fu
+
+#define KL7B_SGM_ADDR           0x6bu
+#define KL7B_I2C_DATA           0x0000u
+#define KL7B_I2C_SLAVE_ADDR1    0x0094u
+#define KL7B_I2C_INTR_MASK      0x0008u
+#define KL7B_I2C_INTR_STAT      0x000cu
+#define KL7B_I2C_CONTROL        0x0010u
+#define KL7B_I2C_TRANSFER_LEN   0x0014u
+#define KL7B_I2C_TRANSAC_LEN    0x0018u
+#define KL7B_I2C_DELAY_LEN      0x001cu
+#define KL7B_I2C_TIMING         0x0020u
+#define KL7B_I2C_START          0x0024u
+#define KL7B_I2C_EXT_CONF       0x0028u
+#define KL7B_I2C_LTIMING        0x002cu
+#define KL7B_I2C_HS             0x0030u
+#define KL7B_I2C_IO_CONFIG      0x0034u
+#define KL7B_I2C_FIFO_CLR       0x0038u
+#define KL7B_I2C_SDA_TIMING     0x003cu
+#define KL7B_I2C_AUX_LEN        0x0044u
+#define KL7B_I2C_CLOCK_DIV      0x0048u
+#define KL7B_I2C_SOFTRESET      0x0050u
+#define KL7B_I2C_SCL_MIS        0x0090u
+
+#define KL7B_I2C_CTRL_RS        (1u << 1)
+#define KL7B_I2C_CTRL_DMA_EN    (1u << 2)
+#define KL7B_I2C_CTRL_CLK_EXT   (1u << 3)
+#define KL7B_I2C_CTRL_DIR_CHG   (1u << 4)
+#define KL7B_I2C_CTRL_ACKERR    (1u << 5)
+#define KL7B_I2C_CTRL_DMAACK    (1u << 8)
+#define KL7B_I2C_CTRL_ASYNC     (1u << 9)
+#define KL7B_I2C_INTR_ARB_LOST  (1u << 3)
+#define KL7B_I2C_INTR_HS_NACK   (1u << 2)
+#define KL7B_I2C_INTR_ACKERR    (1u << 1)
+#define KL7B_I2C_INTR_COMP      (1u << 0)
+#define KL7B_I2C_INTR_ALL       0x001fu
+#define KL7B_I2C_START_BIT      (1u << 0)
+#define KL7B_I2C_SOFT_RST       (1u << 0)
+#define KL7B_I2C_FIFO_CLR_BIT   (1u << 0)
+#define KL7B_I2C_OPEN_DRAIN     0x0003u
+#define KL7B_I2C_CTRL_FIFO      (KL7B_I2C_CTRL_ACKERR | KL7B_I2C_CTRL_CLK_EXT)
+#define KL7B_I2C_DELAY_LEN_VAL  0x0002u
+#define KL7B_I2C_TIMING_400K    0x0229u
+#define KL7B_I2C_LTIMING_400K   0x00bdu
+#define KL7B_I2C_EXT_400K       0x5e01u
+#define KL7B_I2C_SDA_400K       0x100fu
+#define KL7B_I2C_TIMEOUT_US     100000u
+
+#define KL7B_SGM_REG_COUNT      16u
+#define KL7B_SGM_CTRL_CHG       0x9au
+#define KL7B_SGM_CTRL_CHG_PET   0xdau
+#define KL7B_SGM_VREG           0x58u
+#define KL7B_SGM_VREG_FT        0x80u
+#define KL7B_SGM_ICHG           0x88u
+#define KL7B_SGM_CTRL2          0xb7u
+#define KL7B_SGM_IINDPM         0x04u
+
+struct kl7b_state {
+	vm_offset_t pwrap;
+	vm_offset_t i2c;
+	vm_offset_t top;
+	vm_offset_t ifrao;
+	vm_offset_t impc;
+	vm_offset_t gpio;
+	bool adt_checked;
+	bool adt_present;
+	bool mapped;
+	bool pmic_ok;
+	bool i2c_ok;
+	bool ready;
+	bool slow;
+	uint8_t charge_ctrl;
+};
+
+static struct kl7b_state kl7b;
+
+static uint32_t
+kl7b_reg_rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+kl7b_reg_wr32(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static uint32_t
+kl7b_pwrap_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(kl7b.pwrap + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+kl7b_pwrap_wr(uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(kl7b.pwrap + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+kl7b_pwrap_wait(uint32_t want)
+{
+	for (unsigned i = 0; i < KL7B_PMIC_TIMEOUT_US; ++i) {
+		if (((kl7b_pwrap_rd(KL7B_PWRAP_RDATA_FSM) >> 1) & 7u) == want) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static bool
+kl7b_pwrap_read16(uint16_t adr, uint16_t *val)
+{
+	if (!kl7b_pwrap_wait(KL7B_FSM_READY)) {
+		return false;
+	}
+	kl7b_pwrap_wr(KL7B_PWRAP_WACS2_CMD, adr);
+	if (!kl7b_pwrap_wait(KL7B_FSM_READ_DONE)) {
+		kl7b_pwrap_wr(KL7B_PWRAP_VLDCLR, 1);
+		return false;
+	}
+	*val = (uint16_t)(kl7b_pwrap_rd(KL7B_PWRAP_RDATA) & 0xffffu);
+	kl7b_pwrap_wr(KL7B_PWRAP_VLDCLR, 1);
+	return true;
+}
+
+static bool
+kl7b_pwrap_write16(uint16_t adr, uint16_t val)
+{
+	if (!kl7b_pwrap_wait(KL7B_FSM_READY)) {
+		return false;
+	}
+	kl7b_pwrap_wr(KL7B_PWRAP_WDATA, val);
+	kl7b_pwrap_wr(KL7B_PWRAP_WACS2_CMD, (1u << 29) | adr);
+	return true;
+}
+
+static uint16_t
+kl7b_i2c_rd16(uint32_t off)
+{
+	uint16_t v = *(volatile uint16_t *)(kl7b.i2c + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+kl7b_i2c_wr16(uint32_t off, uint16_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint16_t *)(kl7b.i2c + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static uint8_t
+kl7b_i2c_rd8(uint32_t off)
+{
+	uint8_t v = *(volatile uint8_t *)(kl7b.i2c + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+kl7b_i2c_wr8(uint32_t off, uint8_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint8_t *)(kl7b.i2c + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+kl7b_i2c_reset(void)
+{
+	kl7b_i2c_wr16(KL7B_I2C_START, 0);
+	kl7b_i2c_wr16(KL7B_I2C_INTR_STAT, KL7B_I2C_INTR_ALL);
+	kl7b_i2c_wr16(KL7B_I2C_SOFTRESET, KL7B_I2C_SOFT_RST);
+	delay(50);
+	kl7b_i2c_wr16(KL7B_I2C_SOFTRESET, 0);
+	delay(50);
+	kl7b_i2c_wr16(KL7B_I2C_INTR_MASK, 0xffffu);
+	kl7b_i2c_wr16(KL7B_I2C_FIFO_CLR, KL7B_I2C_FIFO_CLR_BIT);
+}
+
+static void
+kl7b_i2c_init(void)
+{
+	kl7b_i2c_reset();
+	kl7b_i2c_wr16(KL7B_I2C_IO_CONFIG, KL7B_I2C_OPEN_DRAIN);
+	kl7b_i2c_wr16(KL7B_I2C_TIMING, KL7B_I2C_TIMING_400K);
+	kl7b_i2c_wr16(KL7B_I2C_HS, 0);
+	kl7b_i2c_wr16(KL7B_I2C_LTIMING, KL7B_I2C_LTIMING_400K);
+	kl7b_i2c_wr16(KL7B_I2C_CLOCK_DIV, 0);
+	kl7b_i2c_wr16(KL7B_I2C_SCL_MIS, 0);
+	kl7b_i2c_wr16(KL7B_I2C_SDA_TIMING, KL7B_I2C_SDA_400K);
+	kl7b_i2c_wr16(KL7B_I2C_EXT_CONF, KL7B_I2C_EXT_400K);
+	kl7b_i2c_wr16(KL7B_I2C_CONTROL, KL7B_I2C_CTRL_FIFO);
+	kl7b_i2c_wr16(KL7B_I2C_DELAY_LEN, KL7B_I2C_DELAY_LEN_VAL);
+	kl7b_i2c_wr16(KL7B_I2C_TRANSFER_LEN, 0);
+	kl7b_i2c_wr16(KL7B_I2C_AUX_LEN, 0);
+	kl7b_i2c_wr16(KL7B_I2C_TRANSAC_LEN, 0);
+	kl7b_i2c_wr16(KL7B_I2C_INTR_MASK, 0xffffu);
+	kl7b_i2c_wr16(KL7B_I2C_FIFO_CLR, KL7B_I2C_FIFO_CLR_BIT);
+}
+
+static int
+kl7b_i2c_wait(uint16_t *stat_out)
+{
+	uint16_t stat = 0;
+	for (unsigned i = 0; i < KL7B_I2C_TIMEOUT_US; ++i) {
+		stat = kl7b_i2c_rd16(KL7B_I2C_INTR_STAT);
+		if (stat & (KL7B_I2C_INTR_COMP | KL7B_I2C_INTR_ACKERR |
+		    KL7B_I2C_INTR_HS_NACK | KL7B_I2C_INTR_ARB_LOST)) {
+			*stat_out = stat;
+			kl7b_i2c_wr16(KL7B_I2C_INTR_MASK, 0xffffu);
+			if (stat & (KL7B_I2C_INTR_ACKERR | KL7B_I2C_INTR_HS_NACK |
+			    KL7B_I2C_INTR_ARB_LOST)) {
+				kl7b_i2c_reset();
+				return -2;
+			}
+			if (!(stat & KL7B_I2C_INTR_COMP)) {
+				kl7b_i2c_reset();
+				return -3;
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	*stat_out = stat;
+	kl7b_i2c_wr16(KL7B_I2C_INTR_MASK, 0xffffu);
+	kl7b_i2c_reset();
+	return -1;
+}
+
+static int
+kl7b_i2c_read_reg(uint8_t addr, uint8_t reg, uint8_t *val, uint16_t *stat_out)
+{
+	uint16_t ctl;
+
+	ctl = kl7b_i2c_rd16(KL7B_I2C_CONTROL);
+	ctl &= (uint16_t)~(KL7B_I2C_CTRL_DMA_EN | KL7B_I2C_CTRL_DMAACK |
+	    KL7B_I2C_CTRL_ASYNC);
+	ctl |= (uint16_t)(KL7B_I2C_CTRL_DIR_CHG | KL7B_I2C_CTRL_RS |
+	    KL7B_I2C_CTRL_ACKERR | KL7B_I2C_CTRL_CLK_EXT);
+	kl7b_i2c_wr16(KL7B_I2C_CONTROL, ctl);
+	kl7b_i2c_wr16(KL7B_I2C_SLAVE_ADDR1, (uint16_t)((uint16_t)addr << 1));
+	kl7b_i2c_wr16(KL7B_I2C_INTR_STAT, KL7B_I2C_INTR_ALL);
+	kl7b_i2c_wr16(KL7B_I2C_FIFO_CLR, KL7B_I2C_FIFO_CLR_BIT);
+	kl7b_i2c_wr16(KL7B_I2C_INTR_MASK, KL7B_I2C_INTR_ALL);
+	kl7b_i2c_wr16(KL7B_I2C_TRANSFER_LEN, 1);
+	kl7b_i2c_wr16(KL7B_I2C_AUX_LEN, 1);
+	kl7b_i2c_wr16(KL7B_I2C_TRANSAC_LEN, 2);
+	kl7b_i2c_wr8(KL7B_I2C_DATA, reg);
+	kl7b_i2c_wr16(KL7B_I2C_START, KL7B_I2C_START_BIT);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	int error = kl7b_i2c_wait(stat_out);
+	if (error) {
+		return error;
+	}
+	*val = kl7b_i2c_rd8(KL7B_I2C_DATA);
+	kl7b_i2c_wr16(KL7B_I2C_INTR_STAT, KL7B_I2C_INTR_ALL);
+	kl7b_i2c_wr16(KL7B_I2C_START, 0);
+	kl7b_i2c_wr16(KL7B_I2C_FIFO_CLR, KL7B_I2C_FIFO_CLR_BIT);
+	return 0;
+}
+
+static int
+kl7b_i2c_write_reg(uint8_t addr, uint8_t reg, uint8_t val, uint16_t *stat_out)
+{
+	uint16_t ctl;
+
+	ctl = kl7b_i2c_rd16(KL7B_I2C_CONTROL);
+	ctl &= (uint16_t)~(KL7B_I2C_CTRL_DMA_EN | KL7B_I2C_CTRL_DMAACK |
+	    KL7B_I2C_CTRL_ASYNC | KL7B_I2C_CTRL_DIR_CHG | KL7B_I2C_CTRL_RS);
+	ctl |= (uint16_t)(KL7B_I2C_CTRL_ACKERR | KL7B_I2C_CTRL_CLK_EXT);
+	kl7b_i2c_wr16(KL7B_I2C_CONTROL, ctl);
+	kl7b_i2c_wr16(KL7B_I2C_SLAVE_ADDR1, (uint16_t)((uint16_t)addr << 1));
+	kl7b_i2c_wr16(KL7B_I2C_INTR_STAT, KL7B_I2C_INTR_ALL);
+	kl7b_i2c_wr16(KL7B_I2C_FIFO_CLR, KL7B_I2C_FIFO_CLR_BIT);
+	kl7b_i2c_wr16(KL7B_I2C_INTR_MASK, KL7B_I2C_INTR_ALL);
+	kl7b_i2c_wr16(KL7B_I2C_TRANSFER_LEN, 2);
+	kl7b_i2c_wr16(KL7B_I2C_AUX_LEN, 0);
+	kl7b_i2c_wr16(KL7B_I2C_TRANSAC_LEN, 1);
+	kl7b_i2c_wr8(KL7B_I2C_DATA, reg);
+	kl7b_i2c_wr8(KL7B_I2C_DATA, val);
+	kl7b_i2c_wr16(KL7B_I2C_START, KL7B_I2C_START_BIT);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	int error = kl7b_i2c_wait(stat_out);
+	if (error) {
+		return error;
+	}
+	kl7b_i2c_wr16(KL7B_I2C_INTR_STAT, KL7B_I2C_INTR_ALL);
+	kl7b_i2c_wr16(KL7B_I2C_START, 0);
+	kl7b_i2c_wr16(KL7B_I2C_FIFO_CLR, KL7B_I2C_FIFO_CLR_BIT);
+	return 0;
+}
+
+static int
+kl7b_read_charger(uint8_t regs[KL7B_SGM_REG_COUNT])
+{
+	if (!kl7b.i2c_ok) {
+		return -1;
+	}
+	for (uint32_t i = 0; i < KL7B_SGM_REG_COUNT; ++i) {
+		uint16_t stat = 0;
+		int error = kl7b_i2c_read_reg(KL7B_SGM_ADDR, (uint8_t)i,
+		    &regs[i], &stat);
+		if (error) {
+			return error;
+		}
+		delay(100);
+	}
+	return 0;
+}
+
+static void
+kl7b_auxadc_stop(void)
+{
+	(void)kl7b_pwrap_write16(KL7B_MT6358_RQST0, 0);
+	delay(10);
+}
+
+static int
+kl7b_auxadc_read(uint32_t req_bit, uint16_t out_reg, uint32_t res,
+    uint32_t avg, uint32_t *out)
+{
+	uint16_t v = 0;
+
+	if (!kl7b_pwrap_write16(KL7B_MT6358_RQST0, (uint16_t)(1u << req_bit))) {
+		return -1;
+	}
+	delay(avg * KL7B_AUXADC_AVG_US);
+
+	for (uint32_t i = 0; i < KL7B_AUXADC_POLLS; ++i) {
+		if (!kl7b_pwrap_read16(out_reg, &v)) {
+			kl7b_auxadc_stop();
+			return -2;
+		}
+		if ((v >> KL7B_AUXADC_RDY_SHIFT) & 1u) {
+			*out = v & ((1u << res) - 1u);
+			kl7b_auxadc_stop();
+			return 0;
+		}
+		delay(KL7B_AUXADC_POLL_US);
+	}
+	kl7b_auxadc_stop();
+	return -3;
+}
+
+static int
+kl7b_read_voltage(uint32_t *mv)
+{
+	uint32_t raw = 0;
+
+	if (kl7b_auxadc_read(0, KL7B_MT6358_ADC0, 15, 0x80, &raw) != 0) {
+		return -1;
+	}
+	*mv = (uint32_t)(((uint64_t)raw * 3u * KL7B_AUXADC_FULL_MV) /
+	    (1u << 15));
+	return (*mv >= 2500 && *mv <= 4700) ? 0 : -1;
+}
+
+static int
+kl7b_read_temp(uint32_t *mv)
+{
+	uint32_t raw = 0;
+
+	if (kl7b_auxadc_read(3, KL7B_MT6358_ADC3, 12, 8, &raw) != 0) {
+		return -1;
+	}
+	*mv = (uint32_t)(((uint64_t)raw * 2u * KL7B_AUXADC_FULL_MV) /
+	    (1u << 12));
+	return (*mv >= 100 && *mv <= 1700) ? 0 : -1;
+}
+
+static uint32_t
+kl7b_soc(uint32_t mv)
+{
+	static const uint32_t volts[] = {
+		3400, 3500, 3600, 3700, 3800, 3900,
+		4000, 4100, 4200, 4300, 4400
+	};
+	static const uint32_t soc[] = {
+		1, 5, 10, 18, 32, 50, 68, 80, 88, 94, 100
+	};
+	const uint32_t count = (uint32_t)(sizeof(volts) / sizeof(volts[0]));
+
+	if (mv <= volts[0]) {
+		return soc[0];
+	}
+	for (uint32_t i = 1; i < count; ++i) {
+		if (mv < volts[i]) {
+			return soc[i - 1] + (mv - volts[i - 1]) *
+			    (soc[i] - soc[i - 1]) / (volts[i] - volts[i - 1]);
+		}
+	}
+	return 100;
+}
+
+static int32_t
+kl7b_temp_cdeg(uint32_t mv)
+{
+	/* 10 k NTC, roughly 900 mV at 25 C and -19 mV/C around room temp.
+	 * This is an uncalibrated estimate; the PMIC efuse calibration is not
+	 * applied.  It is still useful for detecting a hot or cold pack. */
+	int32_t cdeg = 2500 + ((int32_t)900 - (int32_t)mv) * 100 / 19;
+	if (cdeg < -2000) {
+		cdeg = -2000;
+	}
+	if (cdeg > 8000) {
+		cdeg = 8000;
+	}
+	return cdeg;
+}
+
+static bool
+kl7b_adt_present(void)
+{
+	DTEntry entry;
+
+	if (kl7b.adt_checked) {
+		return kl7b.adt_present;
+	}
+	kl7b.adt_checked = true;
+	kl7b.adt_present = SecureDTLookupEntry(NULL, "/kl7-ufs", &entry) ==
+	    kSuccess;
+	return kl7b.adt_present;
+}
+
+static bool
+kl7b_map(void)
+{
+	if (kl7b.mapped) {
+		return true;
+	}
+	kl7b.pwrap = ml_io_map(KL7B_PWRAP_PA, KL7B_MMIO_SIZE);
+	kl7b.i2c = ml_io_map(KL7B_I2C5_PA, KL7B_MMIO_SIZE);
+	kl7b.top = ml_io_map(KL7B_TOPCKGEN_PA, KL7B_MMIO_SIZE);
+	kl7b.ifrao = ml_io_map(KL7B_IFRAO_PA, KL7B_MMIO_SIZE);
+	kl7b.impc = ml_io_map(KL7B_IMPC_PA, KL7B_MMIO_SIZE);
+	kl7b.gpio = ml_io_map(KL7B_GPIO_PA, KL7B_MMIO_SIZE);
+	if (!kl7b.pwrap || !kl7b.i2c || !kl7b.top || !kl7b.ifrao ||
+	    !kl7b.impc || !kl7b.gpio) {
+		return false;
+	}
+	kl7b.mapped = true;
+	return true;
+}
+
+static bool
+kl7b_pmic_init(void)
+{
+	uint16_t swcid = 0;
+	uint32_t init = kl7b_pwrap_rd(KL7B_PWRAP_INIT_DONE2);
+	uint32_t rdata = kl7b_pwrap_rd(KL7B_PWRAP_RDATA_FSM);
+	uint8_t chip;
+
+	printf("KL7 BATTERY: pwrap init=%#x fsm=%u sync=%u\n", init,
+	    (rdata >> 1) & 7u, !!(rdata & (1u << 20)));
+	if (!kl7b_pwrap_read16(KL7B_MT6358_SWCID, &swcid)) {
+		printf("KL7 BATTERY: SWCID read failed\n");
+		return false;
+	}
+	chip = (uint8_t)(swcid >> 8);
+	if (chip != KL7B_MT6366_CHIP_ID && chip != KL7B_MT6358_CHIP_ID) {
+		printf("KL7 BATTERY: unexpected SWCID=%#x chip=%#x\n", swcid,
+		    chip);
+		return false;
+	}
+	printf("KL7 BATTERY: MT6366 SWCID=%#x\n", swcid);
+	return true;
+}
+
+static bool
+kl7b_i2c_clocks(void)
+{
+	uint32_t top = kl7b_reg_rd32(kl7b.top, KL7B_TOP_CLK_CFG_10);
+	uint32_t ifrao = kl7b_reg_rd32(kl7b.ifrao, KL7B_IFRAO_GATE_STA);
+	uint32_t impc = kl7b_reg_rd32(kl7b.impc, KL7B_IMPC_GATE_STA);
+	uint32_t gpio_off = KL7B_GPIO_MODE_REG(KL7B_I2C_SCL_PIN);
+	uint32_t scl_shift = KL7B_GPIO_MODE_SHIFT(KL7B_I2C_SCL_PIN);
+	uint32_t sda_shift = KL7B_GPIO_MODE_SHIFT(KL7B_I2C_SDA_PIN);
+	uint32_t gpio = kl7b_reg_rd32(kl7b.gpio, gpio_off);
+
+	if (((top >> KL7B_TOP_I2C_MUX_SHIFT) & 3u) != KL7B_TOP_I2C_PARENT) {
+		kl7b_reg_wr32(kl7b.top, KL7B_TOP_CLK_CFG_10_CLR,
+		    KL7B_TOP_I2C_MUX_MASK);
+		kl7b_reg_wr32(kl7b.top, KL7B_TOP_CLK_CFG_10_SET,
+		    KL7B_TOP_I2C_PARENT << KL7B_TOP_I2C_MUX_SHIFT);
+		kl7b_reg_wr32(kl7b.top, KL7B_TOP_CLK_CFG_UPDATE1,
+		    KL7B_TOP_I2C_UPDATE_BIT);
+		delay(20);
+	}
+	kl7b_reg_wr32(kl7b.top, KL7B_TOP_CLK_CFG_10_CLR,
+	    KL7B_TOP_I2C_GATE_BIT);
+	kl7b_reg_wr32(kl7b.top, KL7B_TOP_CLK_CFG_UPDATE1,
+	    KL7B_TOP_I2C_UPDATE_BIT);
+	kl7b_reg_wr32(kl7b.ifrao, KL7B_IFRAO_GATE_CLR, KL7B_IFRAO_I2C_BIT);
+	kl7b_reg_wr32(kl7b.impc, KL7B_IMPC_GATE_CLR, KL7B_IMPC_I2C5_BIT);
+	delay(50);
+
+	top = kl7b_reg_rd32(kl7b.top, KL7B_TOP_CLK_CFG_10);
+	ifrao = kl7b_reg_rd32(kl7b.ifrao, KL7B_IFRAO_GATE_STA);
+	impc = kl7b_reg_rd32(kl7b.impc, KL7B_IMPC_GATE_STA);
+	if (((top >> KL7B_TOP_I2C_MUX_SHIFT) & 3u) != KL7B_TOP_I2C_PARENT ||
+	    ((top >> KL7B_TOP_I2C_MUX_GATE) & 1u) != 0u ||
+	    (ifrao & KL7B_IFRAO_I2C_BIT) != 0u ||
+	    (impc & KL7B_IMPC_I2C5_BIT) != 0u) {
+		printf("KL7 BATTERY: i2c clocks not ready top=%#x ifrao=%#x impc=%#x\n",
+		    top, ifrao, impc);
+		return false;
+	}
+
+	gpio &= ~(KL7B_GPIO_MODE_MASK << scl_shift);
+	gpio |= KL7B_I2C_PIN_FUNC << scl_shift;
+	gpio &= ~(KL7B_GPIO_MODE_MASK << sda_shift);
+	gpio |= KL7B_I2C_PIN_FUNC << sda_shift;
+	kl7b_reg_wr32(kl7b.gpio, gpio_off, gpio);
+	delay(20);
+	gpio = kl7b_reg_rd32(kl7b.gpio, gpio_off);
+	if (((gpio >> scl_shift) & KL7B_GPIO_MODE_MASK) != KL7B_I2C_PIN_FUNC ||
+	    ((gpio >> sda_shift) & KL7B_GPIO_MODE_MASK) != KL7B_I2C_PIN_FUNC) {
+		printf("KL7 BATTERY: i2c pinmux not ready gpio=%#x\n", gpio);
+		return false;
+	}
+	return true;
+}
+
+int
+kl7_battery_init(void)
+{
+	if (kl7b.ready) {
+		return 0;
+	}
+	if (!kl7b_adt_present()) {
+		return -1;
+	}
+	if (!kl7b_map()) {
+		printf("KL7 BATTERY: MMIO map failed\n");
+		return -1;
+	}
+	if (!kl7b.pmic_ok) {
+		if (!kl7b_pmic_init()) {
+			return -1;
+		}
+		kl7b.pmic_ok = true;
+	}
+	if (!kl7b.i2c_ok) {
+		if (kl7b_i2c_clocks()) {
+			kl7b_i2c_init();
+			kl7b.i2c_ok = true;
+		} else {
+			printf("KL7 BATTERY: i2c5 unavailable; charger status disabled\n");
+		}
+	}
+	kl7b.ready = true;
+	return 0;
+}
+
+int
+kl7_battery_read(struct kl7_battery_sample *sample)
+{
+	uint32_t mv = 0, temp_mv = 0;
+	uint8_t regs[KL7B_SGM_REG_COUNT];
+	bool voltage_ok;
+	bool temp_ok;
+	bool charger_ok;
+
+	if (!sample) {
+		return -EINVAL;
+	}
+	bzero(sample, sizeof(*sample));
+	if (kl7_battery_init() != 0) {
+		return -1;
+	}
+
+	voltage_ok = kl7b_read_voltage(&mv) == 0;
+	temp_ok = kl7b_read_temp(&temp_mv) == 0;
+	charger_ok = kl7b_read_charger(regs) == 0;
+
+	if (voltage_ok) {
+		sample->voltage_mv = mv;
+		sample->percent = kl7b_soc(mv);
+		sample->flags |= KL7_BAT_VALID;
+	}
+	if (temp_ok) {
+		sample->temperature_cdeg = kl7b_temp_cdeg(temp_mv);
+		sample->flags |= KL7_BAT_TEMP_VALID;
+	}
+	if (charger_ok) {
+		uint32_t chg_stat = (regs[8] >> 3) & 3u;
+		uint32_t pg_stat = (regs[8] >> 2) & 1u;
+		uint32_t vbus_stat = (regs[8] >> 5) & 7u;
+		bool external = pg_stat != 0 && vbus_stat != 0;
+
+		sample->flags |= KL7_BAT_CHARGER_VALID;
+		sample->fault = regs[9];
+		if (external) {
+			sample->flags |= KL7_BAT_EXTERNAL;
+		}
+		if (external && sample->fault == 0) {
+			if (chg_stat == 1 || chg_stat == 2) {
+				sample->flags |= KL7_BAT_CHARGING;
+			} else if (chg_stat == 3) {
+				sample->flags |= KL7_BAT_FULL;
+			}
+		}
+		if (kl7b.slow) {
+			printf("KL7 BATTERY: slow 00=%#x 02=%#x 04=%#x 05=%#x 09=%#x\n",
+			    regs[0x00], regs[0x02], regs[0x04], regs[0x05],
+			    regs[0x09]);
+		}
+	}
+	sample->current_ma = 0; /* no battery-current ADC on the SGM41516D */
+	return (voltage_ok || charger_ok) ? 0 : -1;
+}
+
+int
+kl7_battery_enable_slow_charge(void)
+{
+	static const uint8_t wr_reg[6] = { 0x01, 0x04, 0x0f, 0x02, 0x05, 0x00 };
+	static const uint8_t wr_val[6] = {
+		KL7B_SGM_CTRL_CHG, KL7B_SGM_VREG, KL7B_SGM_VREG_FT,
+		KL7B_SGM_ICHG, KL7B_SGM_CTRL2, KL7B_SGM_IINDPM
+	};
+	uint8_t regs[KL7B_SGM_REG_COUNT];
+	uint8_t rb[KL7B_SGM_REG_COUNT];
+	uint16_t stat = 0;
+
+	if (kl7_battery_init() != 0 || !kl7b.i2c_ok) {
+		return -1;
+	}
+	if (kl7b_read_charger(regs) != 0) {
+		return -2;
+	}
+	if (regs[9] != 0) {
+		printf("KL7 BATTERY: charger fault=%#x; refusing slow-charge write\n",
+		    regs[9]);
+		return -3;
+	}
+	for (uint32_t i = 0; i < 6; ++i) {
+		int error = kl7b_i2c_write_reg(KL7B_SGM_ADDR, wr_reg[i],
+		    wr_val[i], &stat);
+		if (error) {
+			printf("KL7 BATTERY: write %#x=%#x failed rc=%d stat=%#x\n",
+			    wr_reg[i], wr_val[i], error, stat);
+			return -4;
+		}
+		delay(1000);
+	}
+	if (kl7b_read_charger(rb) != 0) {
+		return -5;
+	}
+	if (rb[0x00] != KL7B_SGM_IINDPM ||
+	    (rb[0x01] & (uint8_t)~0x40u) != KL7B_SGM_CTRL_CHG ||
+	    rb[0x02] != KL7B_SGM_ICHG ||
+	    rb[0x04] != KL7B_SGM_VREG ||
+	    rb[0x05] != KL7B_SGM_CTRL2 ||
+	    rb[0x0f] != KL7B_SGM_VREG_FT) {
+		printf("KL7 BATTERY: slow-charge verify failed 00=%#x 01=%#x 02=%#x 04=%#x 05=%#x 0f=%#x\n",
+		    rb[0x00], rb[0x01], rb[0x02], rb[0x04], rb[0x05],
+		    rb[0x0f]);
+		return -6;
+	}
+
+	kl7b.charge_ctrl = KL7B_SGM_CTRL_CHG;
+	kl7b.slow = true;
+	printf("KL7 BATTERY: slow regs 00..07 = %02x %02x %02x %02x %02x %02x %02x %02x\n",
+	    rb[0], rb[1], rb[2], rb[3], rb[4], rb[5], rb[6], rb[7]);
+	printf("KL7 BATTERY: slow regs 08..0f = %02x %02x %02x %02x %02x %02x %02x %02x\n",
+	    rb[8], rb[9], rb[10], rb[11], rb[12], rb[13], rb[14], rb[15]);
+	printf("KL7 BATTERY: slow charge cv=4200mV ichg=480mA iindpm=500mA otg=0 chg=1 wdt=160s timer=off fault=%#x\n",
+	    rb[0x09]);
+	return 0;
+}
+
+int
+kl7_battery_keepalive(void)
+{
+	uint16_t stat = 0;
+
+	if (!kl7b.slow) {
+		return 0;
+	}
+	if (kl7b_i2c_write_reg(KL7B_SGM_ADDR, 0x01, KL7B_SGM_CTRL_CHG_PET,
+	    &stat) != 0) {
+		return -1;
+	}
+	delay(1000);
+	if (kl7b_i2c_write_reg(KL7B_SGM_ADDR, 0x01, kl7b.charge_ctrl,
+	    &stat) != 0) {
+		return -2;
+	}
+	return 0;
+}
