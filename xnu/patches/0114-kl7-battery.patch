@@ -0,0 +1,51 @@
+/*
+ * KL7 battery telemetry backend for the built-in SweetBattery service.
+ *
+ * The MT6366 PMIC is reached through the MT6789 PMIC wrapper and its AUXADC
+ * channels.  The SGM41516D charger is reached over i2c5.  Both paths are
+ * read-only unless kl7_battery_enable_slow_charge() is called explicitly.
+ */
+#ifndef _BSD_DEV_KL7_BATTERY_H_
+#define _BSD_DEV_KL7_BATTERY_H_
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define KL7_BAT_VALID          0x0001u /* AUXADC battery voltage is usable */
+#define KL7_BAT_EXTERNAL       0x0002u /* charger reports a good input */
+#define KL7_BAT_CHARGING       0x0004u /* charger is pre/fast charging */
+#define KL7_BAT_FULL           0x0008u /* charger reports termination */
+#define KL7_BAT_CURRENT_VALID  0x0010u /* current_ma is meaningful */
+#define KL7_BAT_TEMP_VALID     0x0020u /* temperature_cdeg is meaningful */
+#define KL7_BAT_CHARGER_VALID  0x0040u /* SGM registers were read */
+
+struct kl7_battery_sample {
+	uint32_t voltage_mv;
+	int32_t  current_ma;      /* reserved; SGM41516D has no current ADC */
+	int32_t  temperature_cdeg;
+	uint32_t percent;         /* voltage-derived, uncalibrated */
+	uint32_t flags;           /* KL7_BAT_* */
+	uint32_t fault;           /* SGM41516D REG0x09 */
+};
+
+/* Returns 0 when this is a KL7 and the PMIC/AUXADC path is usable. */
+int kl7_battery_init(void);
+/* Fills a sample.  Returns 0 when at least one source produced valid data. */
+int kl7_battery_read(struct kl7_battery_sample *sample);
+/*
+ * Writes the exact sequence validated by the shim write test:
+ * 4.200 V, 480 mA, 500 mA input, OTG off, charging on, 160 s watchdog.
+ * Refuses to write when REG0x09 reports any fault.
+ */
+int kl7_battery_enable_slow_charge(void);
+/* Pets the 160 s watchdog if slow charging was enabled. */
+int kl7_battery_keepalive(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _BSD_DEV_KL7_BATTERY_H_ */
