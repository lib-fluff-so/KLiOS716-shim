+void
+SweetBattery::pollKl7(void)
+{
+	struct kl7_battery_sample sample;
+	if (kl7_battery_read(&sample) != 0) {
+		if (!fKl7Valid) {
+			publish(100, 4200, 0, true, true, false, true, false, false,
+			    2500);
+		}
+		return;
+	}
+	bool measured = (sample.flags & KL7_BAT_VALID) != 0;
+	bool external = (sample.flags & KL7_BAT_EXTERNAL) != 0;
+	bool charging = (sample.flags & KL7_BAT_CHARGING) != 0;
+	bool full = (sample.flags & KL7_BAT_FULL) != 0;
+	bool currentValid = (sample.flags & KL7_BAT_CURRENT_VALID) != 0;
+	int temp = (sample.flags & KL7_BAT_TEMP_VALID) ?
+	    (int)sample.temperature_cdeg : 2500;
+
+	if (!measured) {
+		/* Keep the last good voltage-derived sample across a transient
+		 * AUXADC failure instead of flashing 100% AC every 30 s. */
+		if (!fKl7Valid) {
+			publish(100, 4200, 0, external, external, charging, full,
+			    false, false, temp);
+		}
+		return;
+	}
+	fKl7Valid = true;
+	publish(full ? 100 : sample.percent, sample.voltage_mv, sample.current_ma,
+	    external, external, charging, full, true, currentValid, temp);
+	IOLog("KL7 BATTERY: sample mv=%u pct=%u external=%d charging=%d full=%d temp=%d fault=%#x flags=%#x\n",
+	    sample.voltage_mv, sample.percent, external, charging, full, temp,
+	    sample.fault, sample.flags);
+}
