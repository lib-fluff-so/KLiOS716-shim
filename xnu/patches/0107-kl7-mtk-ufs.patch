+/*
+ * One UFS QUERY REQUEST in slot 0. Used for the fDeviceInit handshake: after
+ * a device reset every LU stays NOT READY until the host sets this flag and
+ * the device clears it.
+ */
+static int
+ufs_query_flag(uint32_t opcode, uint32_t idn, uint32_t index, uint32_t *val)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD;
+
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+
+	ucd->cmd[0] = UPIU_TRANSACTION_QUERY_REQ;
+	ucd->cmd[2] = 0;                        /* LUN 0: device management */
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[5] = (opcode == UPIU_QUERY_OPCODE_SET_FLAG) ?
+	    UPIU_QUERY_FUNC_STANDARD_WRITE : UPIU_QUERY_FUNC_STANDARD_READ;
+	ucd->cmd[12] = (uint8_t)opcode;
+	ucd->cmd[13] = (uint8_t)idn;
+	ucd->cmd[14] = (uint8_t)index;
+	ucd->cmd[15] = 0;
+
+	utrd->dw0 = (1u << 28) | (1u << 24);
+	utrd->dw2 = 0x0f;
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+
+	if (su.cache) {
+		dma_clean(DMA_UTRL, sizeof(*utrd));
+		dma_clean(DMA_UCD, 16);
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	} else {
+		dma_sync(DMA_UTRL, sizeof(*utrd));
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	for (int i = 0; i < 1000; i++) {
+		if (!(ufs_rd(REG_UTRLDBR) & 1)) {
+			break;
+		}
+		delay(1);
+	}
+	if (ufs_rd(REG_UTRLDBR) & 1) {
+		ufs_wr(REG_UTRLCLR, ~1u);
+		printf("KL7 UFS: query op 0x%x idn 0x%x timeout\n", opcode, idn);
+		return ETIMEDOUT;
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	if (su.cache) {
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	} else {
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+
+	uint32_t ocs = utrd->dw2 & 0xff;
+	uint32_t value = (uint32_t)ucd->resp[20] << 24 |
+	    (uint32_t)ucd->resp[21] << 16 |
+	    (uint32_t)ucd->resp[22] << 8 | ucd->resp[23];
+	if (val) {
+		*val = value;
+	}
+	if (ocs || ucd->resp[0] != UPIU_TRANSACTION_QUERY_RSP || ucd->resp[6]) {
+		printf("KL7 UFS: query op 0x%x idn 0x%x ocs 0x%x upiu 0x%x rsp 0x%x val 0x%x\n",
+		    opcode, idn, ocs, ucd->resp[0], ucd->resp[6], value);
+		return EIO;
+	}
+	if (opcode == UPIU_QUERY_OPCODE_SET_FLAG) {
+		printf("KL7 UFS: query SET idn 0x%x val 0x%x\n", idn, value);
+	}
+	return 0;
+}
+
+static int
+ufs_complete_dev_init(void)
+{
+	uint32_t val = 0;
+	int error = ufs_query_flag(UPIU_QUERY_OPCODE_SET_FLAG,
+	    QUERY_FLAG_IDN_FDEVICEINIT, 0, &val);
+	printf("KL7 UFS: fDeviceInit SET rc %d\n", error);
+	if (error) {
+		return error;
+	}
+	for (int i = 0; i < 300; i++) {
+		error = ufs_query_flag(UPIU_QUERY_OPCODE_READ_FLAG,
+		    QUERY_FLAG_IDN_FDEVICEINIT, 0, &val);
+		if (error || !(val & 1u)) {
+			break;
+		}
+		delay(5);
+	}
+	printf("KL7 UFS: fDeviceInit poll rc %d val 0x%x\n", error, val);
+	return error;
+}
