 /*
+ * MediaTek MT6789 bring-up. Based on the hardware-proven ufs_test.c from the
+ * KL7 shim (v7): infracfg_ao host reset, HCE 1->0->1, secure-monitor device
+ * reset and reference clock, UniPro link startup, then fDeviceInit.
+ */
+
+static uint64_t
+mtk_smc(uint64_t cmd, uint64_t val)
+{
+	register uint64_t x0 __asm__("x0") = MTK_SIP_UFS_CONTROL;
+	register uint64_t x1 __asm__("x1") = cmd;
+	register uint64_t x2 __asm__("x2") = val;
+	register uint64_t x3 __asm__("x3") = 0;
+	register uint64_t x4 __asm__("x4") = 0;
+	register uint64_t x5 __asm__("x5") = 0;
+	register uint64_t x6 __asm__("x6") = 0;
+	register uint64_t x7 __asm__("x7") = 0;
+
+	__asm__ volatile("smc #0" : "+r"(x0)
+	    : "r"(x1), "r"(x2), "r"(x3), "r"(x4), "r"(x5), "r"(x6), "r"(x7)
+	    : "memory");
+	return x0;
+}
+
+static uint32_t
+infracfg_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(su.infracfg + off);
+}
+
+static void
+infracfg_set(uint32_t off, uint32_t bit)
+{
+	*(volatile uint32_t *)(su.infracfg + off) = infracfg_rd(off) | (1u << bit);
+}
+
+static void
+mtk_host_reset(void)
+{
+	infracfg_set(INFRACFG_HCI_RST_SET, INFRACFG_HCI_RST_BIT);
+	infracfg_set(INFRACFG_UNIPRO_RST_SET, INFRACFG_UNIPRO_RST_BIT);
+	delay(1);
+	infracfg_set(INFRACFG_UNIPRO_RST_CLR, INFRACFG_UNIPRO_RST_BIT);
+	infracfg_set(INFRACFG_HCI_RST_CLR, INFRACFG_HCI_RST_BIT);
+	delay(1);
+}
+
+static void
+mtk_ref_clk_on(void)
+{
+	uint32_t v = ufs_rd(REG_UFS_REFCLK_CTRL);
+	printf("KL7 UFS: refclk ctrl 0x%x\n", v);
+	if ((v & (UFS_REFCLK_REQUEST | UFS_REFCLK_ACK)) ==
+	    (UFS_REFCLK_REQUEST | UFS_REFCLK_ACK)) {
+		return;
+	}
+	uint64_t s = mtk_smc(UFS_MTK_SIP_REF_CLK_NOTIFICATION, 1);
+	printf("KL7 UFS: refclk smc 0x%llx\n", s);
+	delay(1);
+	ufs_wr(REG_UFS_REFCLK_CTRL, UFS_REFCLK_REQUEST);
+	for (int i = 0; i < 10; i++) {
+		v = ufs_rd(REG_UFS_REFCLK_CTRL);
+		if (((v & UFS_REFCLK_ACK) >> 1) == (v & UFS_REFCLK_REQUEST)) {
+			break;
+		}
+		delay(1);
+	}
+	printf("KL7 UFS: refclk after 0x%x\n", v);
+}
+
+static void
+mtk_hce_cycle(void)
+{
+	if (ufs_rd(REG_HCE) & 1u) {
+		ufs_wr(REG_HCE, 0);
+		for (int i = 0; i < 10 && (ufs_rd(REG_HCE) & 1u); i++) {
+			delay(1);
+		}
+	}
+	printf("KL7 UFS: hce stop 0x%x hcs 0x%x\n", ufs_rd(REG_HCE), ufs_rd(REG_HCS));
+
+	mtk_host_reset();
+	mtk_ref_clk_on();
+
+	ufs_wr(REG_HCE, 1);
+	delay(1);
+	for (int i = 0; i < 1000 && !(ufs_rd(REG_HCE) & 1u); i++) {
+		delay(1);
+	}
+	printf("KL7 UFS: hce start 0x%x hcs 0x%x is 0x%x\n",
+	    ufs_rd(REG_HCE), ufs_rd(REG_HCS), ufs_rd(REG_IS));
+}
+
+static uint32_t
+mtk_uic(uint32_t opcode, uint32_t arg1, uint32_t arg2, uint32_t arg3, uint32_t *val)
+{
+	ufs_wr(REG_IS, IS_UIC_COMMAND_COMPL | IS_UIC_ERROR);
+	ufs_wr(REG_UIC_ARG1, arg1);
+	ufs_wr(REG_UIC_ARG2, arg2);
+	ufs_wr(REG_UIC_ARG3, arg3);
+	ufs_wr(REG_UICCMD, opcode & 0xff);
+
+	for (int i = 0; i < 500; i++) {
+		if (ufs_rd(REG_IS) & IS_UIC_COMMAND_COMPL) {
+			uint32_t result = ufs_rd(REG_UIC_ARG2) & 0xff;
+			if (val) {
+				*val = ufs_rd(REG_UIC_ARG3);
+			}
+			ufs_wr(REG_IS, IS_UIC_COMMAND_COMPL);
+			return result;
+		}
+		delay(1);
+	}
+	return 0x100;
+}
+
+static void
+mtk_pre_link(void)
+{
+	uint32_t v = 0, r;
+	r = mtk_uic(UIC_CMD_DME_SET, VS_UNIPROPOWERDOWNCONTROL << 16, 0, 0, &v);
+	printf("KL7 UFS: HPM rc 0x%x\n", r);
+	r = mtk_uic(UIC_CMD_DME_SET, PA_LOCAL_TX_LCC_ENABLE << 16, 0, 0, &v);
+	printf("KL7 UFS: TXLCC rc 0x%x\n", r);
+	r = mtk_uic(UIC_CMD_DME_GET, VS_SAVEPOWERCONTROL << 16, 0, 0, &v);
+	printf("KL7 UFS: SAVEPWR get rc 0x%x val 0x%x\n", r, v);
+	if (!r) {
+		r = mtk_uic(UIC_CMD_DME_SET, VS_SAVEPOWERCONTROL << 16, 0,
+		    v & ~(1u << 6), &v);
+		printf("KL7 UFS: SAVEPWR set rc 0x%x\n", r);
+	}
+}
+
+static int
+mtk_ufs_init(void)
+{
+	uint32_t cap = ufs_rd(REG_CAP), ver = ufs_rd(REG_VER);
+	uint32_t hcs = ufs_rd(REG_HCS), hce = ufs_rd(REG_HCE);
+	uint32_t v = 0, r;
+	int link_error;
+
+	printf("KL7 UFS: cap 0x%x ver 0x%x hce 0x%x hcs 0x%x\n",
+	    cap, ver, hce, hcs);
+
+	mtk_hce_cycle();
+	printf("KL7 UFS: post-hce hcs 0x%x is 0x%x uecpa 0x%x\n",
+	    ufs_rd(REG_HCS), ufs_rd(REG_IS), ufs_rd(REG_UECPA));
+
+	uint64_t s = mtk_smc(UFS_MTK_SIP_DEVICE_RESET, 0);
+	printf("KL7 UFS: RST low rc 0x%llx\n", s);
+	delay(1);
+	s = mtk_smc(UFS_MTK_SIP_DEVICE_RESET, 1);
+	printf("KL7 UFS: RST high rc 0x%llx\n", s);
+	delay(15);
+
+	mtk_pre_link();
+	r = mtk_uic(UIC_CMD_DME_LINK_STARTUP, 0, 0, 0, &v);
+	printf("KL7 UFS: LINKSTART rc 0x%x\n", r);
+	link_error = (int)r;
+	if (r) {
+		r = mtk_uic(UIC_CMD_DME_RESET, 0, 0, 0, &v);
+		printf("KL7 UFS: DMERESET rc 0x%x\n", r);
+		r = mtk_uic(UIC_CMD_DME_ENABLE, 0, 0, 0, &v);
+		printf("KL7 UFS: DMEENABLE rc 0x%x\n", r);
+		mtk_pre_link();
+		r = mtk_uic(UIC_CMD_DME_LINK_STARTUP, 0, 0, 0, &v);
+		printf("KL7 UFS: LINKSTART2 rc 0x%x\n", r);
+		link_error = (int)r;
+	}
+	r = mtk_uic(UIC_CMD_DME_GET, PA_PWRMODE << 16, 0, 0, &v);
+	printf("KL7 UFS: PA_PWRMODE rc 0x%x val 0x%x\n", r, v);
+	printf("KL7 UFS: link hcs 0x%x is 0x%x\n", ufs_rd(REG_HCS), ufs_rd(REG_IS));
+	return link_error ? ENXIO : 0;
+}
